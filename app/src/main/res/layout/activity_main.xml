<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ================= DASHBOARD TAB ================= -->
        <ScrollView
            android:id="@+id/scrollDashboard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/dash_surface"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Status strip -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="bottom"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/textBrand"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-condensed"
                                android:letterSpacing="0.2"
                                android:text="AUTOSENTRY"
                                android:textColor="@color/dash_text"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/textVersion"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:fontFamily="monospace"
                                android:textColor="@color/dash_muted"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/textLiveStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Tracking is off"
                            android:textColor="@color/dash_text"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/textAdapterStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="No OBD adapter paired yet"
                            android:textColor="@color/dash_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textHealth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp"
                        android:text="Idle"
                        android:textColor="@color/dash_muted"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/buttonToggleTracking"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_go"
                        android:minWidth="0dp"
                        android:minHeight="40dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="Start Tracking"
                        android:textAllCaps="false"
                        android:textColor="@color/dash_on_accent"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/buttonTileSize"
                        style="@style/Widget.AppCompat.Button.Borderless"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:text="Size: M"
                        android:textAllCaps="false"
                        android:textColor="@color/dash_accent"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/buttonEditDashboard"
                        style="@style/Widget.AppCompat.Button.Borderless"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:text="Edit readings"
                        android:textAllCaps="false"
                        android:textColor="@color/dash_accent"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textAlert"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:padding="10dp"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <GridLayout
                    android:id="@+id/gridHero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:columnCount="2" />

                <GridLayout
                    android:id="@+id/gridTiles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="3" />

                <GridLayout
                    android:id="@+id/gridPlain"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="3" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="Hold a gauge to make it large, move it or remove it"
                    android:textColor="@color/dash_muted"
                    android:textSize="10sp" />

                <!-- Service strip: taps through to History -->
                <LinearLayout
                    android:id="@+id/cardService"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="OIL LIFE"
                            android:textColor="@color/dash_muted"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/textDashOilPct"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textColor="@color/dash_text"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/progressOil"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="8dp"
                        android:max="100"
                        android:progressBackgroundTint="@color/dash_track"
                        android:progressTint="@color/dash_accent" />

                    <TextView
                        android:id="@+id/textDashNextService"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text=""
                        android:textColor="@color/dash_muted"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- ================= DIAGNOSTICS TAB ================= -->
        <ScrollView
            android:id="@+id/scrollDiagnostics"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:text="Key-on checks (KOEO)" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="14sp"
                    android:textColor="#757575"
                    android:text="Battery, readings and trouble codes at key-on before cranking, then how the crank went." />

                <Button
                    android:id="@+id/buttonKoeoCheck"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Run Key-On Check (key ON, engine off)" />

                <TextView
                    android:id="@+id/textKoeoReports"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textSize="15sp"
                    android:lineSpacingMultiplier="1.15"
                    android:textIsSelectable="true"
                    android:text="Loading…" />
            </LinearLayout>
        </ScrollView>

        <!-- ================= HISTORY TAB ================= -->
        <ScrollView
            android:id="@+id/scrollService"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/textOilLife"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:text="Oil life: --%" />

                <TextView
                    android:id="@+id/textOilDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="16sp"
                    android:text="Since last oil change: -- mi, -- engine hrs" />

                <TextView
                    android:id="@+id/textOdometer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="16sp"
                    android:text="Odometer: -- mi" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#33000000"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/textServiceHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:text="Service schedule" />

                <TextView
                    android:id="@+id/textServiceList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="16sp"
                    android:lineSpacingMultiplier="1.2"
                    android:text="Loading…" />

                <Button
                    android:id="@+id/buttonSetOdometer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Set Odometer" />

                <Button
                    android:id="@+id/buttonResetOil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Log Oil Change (quick)" />

                <Button
                    android:id="@+id/buttonLogMaintenance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Log Maintenance / Upgrade + Photos" />

                <Button
                    android:id="@+id/buttonMaintenanceHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Maintenance History" />
            </LinearLayout>
        </ScrollView>

        <!-- ================= DEALS TAB ================= -->
        <ScrollView
            android:id="@+id/scrollDeals"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:text="No deals matching alerts" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="14sp"
                    android:textColor="#757575"
                    android:text="Deals for parts your service schedule calls for will appear here." />
            </LinearLayout>
        </ScrollView>

        <!-- ================= ACCOUNT TAB ================= -->
        <ScrollView
            android:id="@+id/scrollAccount"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <Button
                    android:id="@+id/buttonSetupWizard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="Setup Wizard" />

                <Button
                    android:id="@+id/buttonPairAdapter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pair OBD Adapter" />

                <Button
                    android:id="@+id/buttonTestConnection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Test OBD Connection" />

                <Button
                    android:id="@+id/buttonAutoTrackingToggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Auto-Tracking: On" />

                <Button
                    android:id="@+id/buttonBackgroundAccess"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Allow background start" />

                <Button
                    android:id="@+id/buttonSaveTrips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Save trips to tablet" />

                <Button
                    android:id="@+id/buttonDebugLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="View Debug Log" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/dock_bg"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/buttonTabDashboard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_dock_item"
            android:clickable="true"
            android:focusable="true"
            android:drawableTop="@drawable/ic_nav_dashboard"
            android:drawableTint="@color/rail_item"
            android:drawablePadding="3dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="DASH"
            android:textColor="@color/rail_item"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/buttonTabDiagnostics"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_dock_item"
            android:clickable="true"
            android:focusable="true"
            android:drawableTop="@drawable/ic_nav_checks"
            android:drawableTint="@color/rail_item"
            android:drawablePadding="3dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="CHECKS"
            android:textColor="@color/rail_item"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/buttonTabService"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_dock_item"
            android:clickable="true"
            android:focusable="true"
            android:drawableTop="@drawable/ic_nav_history"
            android:drawableTint="@color/rail_item"
            android:drawablePadding="3dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="HISTORY"
            android:textColor="@color/rail_item"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/buttonTabDeals"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_dock_item"
            android:clickable="true"
            android:focusable="true"
            android:drawableTop="@drawable/ic_nav_deals"
            android:drawableTint="@color/rail_item"
            android:drawablePadding="3dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="DEALS"
            android:textColor="@color/rail_item"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/buttonTabAccount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_dock_item"
            android:clickable="true"
            android:focusable="true"
            android:drawableTop="@drawable/ic_nav_account"
            android:drawableTint="@color/rail_item"
            android:drawablePadding="3dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="ACCOUNT"
            android:textColor="@color/rail_item"
            android:textSize="9sp" />
    </LinearLayout>
</LinearLayout>
